# Server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Obtain this value from Better Auth Dash; do not use a generated placeholder in production.
BETTER_AUTH_API_KEY=YOUR_API_KEY
# Production: https://nabahah.com (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed to call Better Auth. Include the
# production site and any separate frontend origin used in local/preview.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=3000
DB_POOL_MAX=10

# Optional server-side engine for “مساعد نباهة”. Never expose this key to Vite.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
