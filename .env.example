# Server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Obtain this value from Better Auth Dash; do not use a generated placeholder in production.
BETTER_AUTH_API_KEY=YOUR_API_KEY
# Production: https://step-ebon-sigma.vercel.app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
DB_POOL_MAX=10
