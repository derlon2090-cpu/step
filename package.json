{
  "name": "step-reading",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:data": "py -3 scripts/build_reading_data.py",
    "export:reading-json": "node scripts/export_reading_json.mjs",
    "report:visual": "py -3 scripts/build_visual_question_review_report.py",
    "validate:records": "py -3 scripts/validate_reading_records.py",
    "validate:ui": "py -3 scripts/validate_reading_ui_data.py",
    "validate:visual": "py -3 scripts/validate_visual_question_review.py",
    "validate:manual": "node scripts/validate_manual_quizzes.mjs",
    "validate": "npm run validate:records && npm run validate:visual && npm run validate:ui && npm run validate:manual"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
